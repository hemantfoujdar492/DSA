public class calculator {
    static int multyply(int a, int b){
        return a*b;
        }
        static int multyply(int a, int b, int c){
        return a*b*c;
    }
    static double multyply(double a, double b, double c){
        return a*b*c;
    }
    public static void main(String[]args){
        int return1 = multyply (50,2);
        int return2 = multyply (4,5,8);
        double return3 =  multyply(5.2,3.2,5.98);
        System.out.println(return1);
        System.out.println(return2);
        System.out.println(return3);
    }
}
