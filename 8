import java.util.Scanner;

public class count {
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int [] numbers = {25,26,48,78,96};
        int count = 0;

        for(int i = 0; i < numbers.length; i++){
            if(numbers [i] % 2 ==0){
                count ++;
            }
        }
        System.out.println("Count:"+ count);
    }
}
